filters:
  and:
    - file.ext == "md"
    - not:
        - file.name == "README"
formulas:
  links_out: file.links.length
  linked_from: file.backlinks.length
properties:
  file.name:
    displayName: Note
  file.folder:
    displayName: Folder
  file.tags:
    displayName: Tags
  file.mtime:
    displayName: Last edited
  formula.links_out:
    displayName: Links out
  formula.linked_from:
    displayName: Linked from
views:
  - type: table
    name: By folder
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - formula.linked_from
      - formula.links_out
      - file.tags
      - file.mtime
    columnSize:
      file.tags: 427
  - type: table
    name: Most linked
    order:
      - file.name
      - formula.linked_from
      - file.folder
    sort:
      - property: formula.linked_from
        direction: DESC
    limit: 30
  - type: table
    name: Recently edited
    order:
      - file.name
      - file.mtime
      - file.folder
    sort:
      - property: file.mtime
        direction: DESC
    limit: 25
  - type: table
    name: Nothing links here yet
    filters:
      and:
        - file.backlinks.length == 0
    order:
      - file.name
      - file.folder
      - formula.links_out
  - type: table
    name: Extra (not in course)
    filters:
      and:
        - file.inFolder("Extra (not in course)")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - formula.linked_from
      - file.tags
